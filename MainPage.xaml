<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Chudisoft_Interval_Timer"
    xmlns:components="clr-namespace:Chudisoft_Interval_Timer.Components"
    x:Class="Chudisoft_Interval_Timer.MainPage"
    Title="Chudisoft Interval Timer"
    Shell.NavBarIsVisible="True"
    Padding="0">

    <BlazorWebView
        x:Name="blazorWebView"
        HostPage="wwwroot/index.html"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <BlazorWebView.RootComponents>
            <RootComponent
                Selector="#app"
                ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>

    </BlazorWebView>

</ContentPage>
